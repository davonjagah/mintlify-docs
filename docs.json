{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Transika",
  "theme": "luma",
  "colors": {
    "primary": "#1be49c",
    "light": "#0c8c5c",
    "dark": "#0c0c0c"
  },
  "logo": {
    "light": "https://media.brand.dev/07fcb57b-76a5-49f6-abdb-740da69c791f.svg",
    "dark": "https://media.brand.dev/07fcb57b-76a5-49f6-abdb-740da69c791f.svg"
  },
  "favicon": "https://media.brand.dev/483ee27f-08fb-4d32-842d-86b4c40f9fb4.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "home",
              "getting-started/quickstart",
              "getting-started/authentication",
              "getting-started/environments",
              "getting-started/scopes-and-prerequisites"
            ]
          },
          {
            "group": "API Concepts",
            "pages": [
              "getting-started/responses-and-errors",
              "getting-started/pagination"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/beneficiaries",
              "guides/otc-trades",
              "guides/tghs-treasury",
              "guides/webhooks",
              "guides/sandbox-testing"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tran-sika.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.tran-sika.com"
    }
  },
  "footer": {
    "socials": {}
  },
  "description": "Merchant API documentation for Ghana beneficiaries, OTC trades, managed tGHS balances, payouts, and webhooks.",
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      },
      "server": "https://sbx-institutional.tran-sika.com/v1"
    }
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "search": {
    "prompt": "Search Transika docs..."
  },
  "seo": {
    "indexing": "navigable"
  },
  "icons": {
    "library": "lucide"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/home",
      "permanent": false
    }
  ]
}
